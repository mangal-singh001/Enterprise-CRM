# Root Environment Configuration Template for Internal Enterprise CRM

# Backend Configuration
PROJECT_NAME="Internal Enterprise CRM Platform"
SECRET_KEY="super-secret-internal-idp-signing-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL="sqlite:///./enterprise_crm.db" # Default zero-config SQLite, or swap for MySQL: mysql+pymysql://user:pass@localhost:3306/enterprise_crm
ENVIRONMENT="development"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"
